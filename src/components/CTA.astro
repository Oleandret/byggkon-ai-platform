---
<section id="kontakt" class="py-20 bg-soft border-t border-[var(--line)]">
  <div class="wrap">
    <div class="relative overflow-hidden bg-ink text-white rounded-3xl px-10 py-14 md:py-16 text-center max-w-[920px] mx-auto">
      <div class="absolute -top-1/2 -right-10 w-[500px] h-[500px] rounded-full pointer-events-none"
           style="background: radial-gradient(circle, rgba(245,180,0,0.20) 0%, transparent 60%);">
      </div>
      <div class="relative">
        <h2 class="h2 text-white mb-3">Bygd for dem som <span class="bg-gradient-to-r from-yellow via-fx to-yellow bg-clip-text text-transparent">bygger</span>.</h2>
        <p class="text-white/70 mb-7 max-w-[520px] mx-auto">
          BYGG-KON Stavanger · 40 år · 4 000+ prosjekter
        </p>
        <div class="flex gap-3 justify-center flex-wrap">
          <a href="https://www.byggkon.no" target="_blank" rel="noopener"
             class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-yellow text-ink font-semibold text-sm hover:bg-[#ffc930] transition-colors">
            byggkon.no
          </a>
          <a href="mailto:oat@byggkon.no"
             class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/20 text-white font-semibold text-sm hover:bg-white/10 hover:border-white transition-colors">
            oat@byggkon.no
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

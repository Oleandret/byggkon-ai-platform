<section id="kontakt" class="py-20 lg:py-28">
  <div class="wrap">
    <div class="bg-ink text-white rounded-3xl px-10 lg:px-16 py-16 lg:py-24 text-center relative overflow-hidden">
      <div class="absolute inset-0 pointer-events-none opacity-40"
           style="background: radial-gradient(ellipse at 80% 0%, rgba(245,180,0,0.20) 0%, transparent 50%);">
      </div>
      <div class="relative max-w-[680px] mx-auto">
        <h2 class="h2 text-white mb-5">Klar til å komme i gang med BYGG-KON.ai?</h2>

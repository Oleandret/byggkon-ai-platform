---
const cases = [
  {
    category: 'Byggesak',
    title: 'Søknad om dispensasjon',
    output: 'Dispensasjonssøknad.pdf',
    pages: '4 sider',
    time: '38 sek',
    color: '#c8102e'
  },
  {
    category: 'Uavhengig kontroll',
    title: 'Sjekkliste for UAK',
    output: 'UAK-sjekkliste-Vatrom.pdf',
    pages: '6 sider',
    time: '22 sek',
    color: '#f5b400'
  },
  {
    category: 'Fagprosjektering',
    title: 'KS-plan betong, enebolig',
    output: 'KS-plan-Betong-4118.pdf',
    pages: '12 sider',
    time: '51 sek',
    color: '#0a6cf0'
  },
  {
    category: 'Befaring',
    title: 'Befaringsrapport stål',
    output: 'Befaringsrapport-stal-4072.pdf',
    pages: '8 sider',
    time: '33 sek',
    color: '#7a3fc8'
  }
];
---
<section id="eksempler" class="py-20 lg:py-28">
  <div class="wrap">

    <div class="max-w-[640px] mb-12 lg:mb-16">
      <div class="eyebrow mb-3">Eksempler</div>
      <h2 class="h2 mb-5">Ferdige leveranser.</h2>
      <p class="lede">Dokumenter plattformen produserer på ansattes forespørsel.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {cases.map(c => (
        <article class="bg-white border border-line rounded-2xl p-7 lg:p-8 transition-all hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-20px_rgba(20,24,32,0.10)]">
          <div class="flex items-center gap-2 mb-5">
            <span class="inline-block w-1.5 h-1.5 rounded-full" style={`background:${c.color}`}></span>
            <span class="text-xs font-semibold uppercase tracking-wider text-ink-3">{c.category}</span>
          </div>

          <h3 class="text-xl font-extrabold text-ink leading-tight mb-3">
            {c.title}
          </h3>

          <div class="text-sm text-ink-3 mb-6">
            {c.output} · {c.pages}
          </div>

          <div class="flex items-center justify-between pt-5 border-t border-line">
            <span class="text-xs text-ink-3">Tid fra prompt til ferdig</span>
            <span class="text-sm font-bold text-ink">{c.time}</span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

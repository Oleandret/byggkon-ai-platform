---
const stats = [
  { num: '40',       label: 'År erfaring' },
  { num: '4 000+',   label: 'Prosjekter', live: 'projects' },
  { num: '6',        label: 'MCP-servere' },
  { num: '76 200+',  label: 'Linjer kode', live: 'loc' }
];
---
<section class="pt-36 pb-24 text-center relative overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none"
       style="background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(245,180,0,0.06), transparent 60%);">
  </div>

  <div class="wrap max-w-[920px]">
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-ki/30 bg-ki/[0.08] mb-7">
      <span class="w-1.5 h-1.5 bg-ki rounded-full animate-pulse-dot"></span>
      <span class="font-mono text-[11px] font-bold tracking-[0.16em] uppercase text-ki">
        Live · 6 MCP-servere · Claude Opus 4.7
      </span>
    </div>

    <h1 class="h1 mb-6">
      All vår kunnskap.<br>
      <span class="bg-gradient-to-r from-loki via-fx to-yellow bg-clip-text text-transparent">
        Ett system.
      </span>
    </h1>

    <p class="lede mx-auto mb-9">
      Seks AI-agenter koblet til Claude gjennom egne MCP-servere. Hele BYGG-KONs samlede kunnskap, økonomi og eiendomsregister i én chat.
    </p>

    <div class="flex gap-3 justify-center flex-wrap mb-16">
      <a href="#agenter" class="btn btn-primary">
        Se agentene
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </a>
      <a href="#pipeline" class="btn btn-ghost">Slik virker det</a>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-5 max-w-[760px] mx-auto pt-10 border-t border-[var(--line)]">
      {stats.map(s => (
        <div class="text-center">
          <div class="font-mono font-extrabold text-2xl md:text-3xl text-ink leading-none tracking-tight" data-live={s.live ?? ''}>
            {s.num}
          </div>
          <div class="font-mono text-[10.5px] uppercase tracking-[0.14em] text-ink-3 mt-2">
            {s.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Live ticker on "Linjer kode" + "Prosjekter"
  const loc = document.querySelector('[data-live="loc"]');
  const proj = document.querySelector('[data-live="projects"]');
  if (loc) {
    let v = 76200;
    setInterval(() => {
      if (Math.random() < 0.4) {
        v += Math.floor(Math.random() * 4) + 1;
        loc.textContent = v.toLocaleString('no-NO').replace(/,/g, ' ') + '+';
      }
    }, 1500);
  }
  if (proj) {
    let v = 4000;
    setInterval(() => {
      if (Math.random() < 0.25) {
        v += 1;
        proj.textContent = v.toLocaleString('no-NO').replace(/,/g, ' ') + '+';
      }
    }, 1800);
  }
</script>

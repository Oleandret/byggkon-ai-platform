---
// Hero — static, minimal, byggkon.no aesthetic
---
<section class="pt-32 pb-20 lg:pt-40 lg:pb-28">
  <div class="wrap grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center">

    <!-- LEFT: Text -->
    <div>
      <div class="eyebrow mb-6">AI-plattform for BYGG-KON</div>

      <h1 class="h1 mb-6">
        Kunnskap i system med <span class="text-yellow">AI</span>.
      </h1>

      <p class="lede mb-9 max-w-[560px]">
        Vi har samlet 40 års byggfaglig erfaring i én plattform. Seks AI-agenter
        hjelper ansatte med å produsere ferdig dokumentasjon på sekunder.
      </p>

      <div class="flex flex-wrap gap-3 mb-12">
        <a href="#agenter" class="btn btn-primary">Se agentene</a>
        <a href="#eksempler" class="btn btn-secondary">Se eksempler</a>
      </div>

      <div class="flex flex-wrap items-center gap-x-10 gap-y-5">
        <div>
          <div class="text-3xl md:text-4xl font-extrabold text-ink leading-none tracking-tighter">6</div>
          <div class="text-sm text-ink-3 mt-1.5">AI-agenter</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-extrabold text-ink leading-none tracking-tighter">40+</div>
          <div class="text-sm text-ink-3 mt-1.5">År erfaring</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-extrabold text-ink leading-none tracking-tighter">4 000+</div>
          <div class="text-sm text-ink-3 mt-1.5">Prosjekter</div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Static, calm visual -->
    <div class="aspect-square bg-cream rounded-3xl border border-line p-8 lg:p-10 flex items-center justify-center">
      <svg viewBox="0 0 360 360" class="w-full h-auto max-w-[400px]">
        <!-- 6 agent dots around a central Claude circle. No animations. -->
        <!-- Connecting lines -->
        <g stroke="#1a1d23" stroke-opacity="0.10" stroke-width="1" fill="none">
          <line x1="180" y1="180" x2="180" y2="60"/>
          <line x1="180" y1="180" x2="285" y2="120"/>
          <line x1="180" y1="180" x2="285" y2="240"/>
          <line x1="180" y1="180" x2="180" y2="300"/>
          <line x1="180" y1="180" x2="75"  y2="240"/>
          <line x1="180" y1="180" x2="75"  y2="120"/>
        </g>

        <!-- Hub -->
        <circle cx="180" cy="180" r="52" fill="#ffffff" stroke="#1a1d23" stroke-width="1.5"/>
        <text x="180" y="178" text-anchor="middle" font-size="16" font-weight="800" fill="#1a1d23">Claude</text>
        <text x="180" y="195" text-anchor="middle" font-size="10" font-weight="500" fill="#6b7280">Opus 4.7</text>

        <!-- Nodes -->
        <g>
          <circle cx="180" cy="60"  r="24" fill="#ffffff" stroke="#c8102e" stroke-width="1.5"/>
          <text x="180" y="65" text-anchor="middle" font-size="11" font-weight="700" fill="#1a1d23">Loki</text>

          <circle cx="285" cy="120" r="24" fill="#ffffff" stroke="#f5b400" stroke-width="1.5"/>
          <text x="285" y="125" text-anchor="middle" font-size="11" font-weight="700" fill="#1a1d23">Nova</text>

          <circle cx="285" cy="240" r="24" fill="#ffffff" stroke="#7a3fc8" stroke-width="1.5"/>
          <text x="285" y="245" text-anchor="middle" font-size="9" font-weight="700" fill="#1a1d23">Tripletex</text>

          <circle cx="180" cy="300" r="24" fill="#ffffff" stroke="#1f8a3a" stroke-width="1.5"/>
          <text x="180" y="298" text-anchor="middle" font-size="9" font-weight="700" fill="#1a1d23">KI</text>
          <text x="180" y="310" text-anchor="middle" font-size="9" font-weight="700" fill="#1a1d23">Tilbud</text>

          <circle cx="75"  cy="240" r="24" fill="#ffffff" stroke="#ff6b35" stroke-width="1.5"/>
          <text x="75" y="238" text-anchor="middle" font-size="9" font-weight="700" fill="#1a1d23">Epost-</text>
          <text x="75" y="250" text-anchor="middle" font-size="9" font-weight="700" fill="#1a1d23">agent</text>

          <circle cx="75"  cy="120" r="24" fill="#ffffff" stroke="#0a6cf0" stroke-width="1.5"/>
          <text x="75" y="125" text-anchor="middle" font-size="11" font-weight="700" fill="#1a1d23">Hilde</text>
        </g>
      </svg>
    </div>

  </div>
</section>

---
// Hero — animated AI architecture, byggkon.no split-screen layout
---
<section class="pt-32 pb-20 lg:pt-40 lg:pb-28">
  <div class="wrap grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center">

    <!-- LEFT: Text -->
    <div>
      <div class="flex items-center gap-2 mb-6">
        <span class="w-8 h-8 rounded-full bg-yellow/15 flex items-center justify-center">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f5b400" stroke-width="2.5">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </span>
        <span class="eyebrow">AI-plattform bygget på 40 års erfaring</span>
      </div>

      <h1 class="h1 mb-6">
        Kunnskap i <span class="text-yellow">system</span> med AI.
      </h1>

      <p class="lede mb-9 max-w-[560px]">
        BYGG-KON.ai samler vår fagkunnskap, økonomi og eiendomsregister
        i ett system. Seks spesialiserte agenter, koblet til Claude via MCP &mdash;
        ansatte produserer ferdig dokumentasjon på sekunder.
      </p>

      <div class="flex flex-wrap gap-3 mb-12">
        <a href="#agenter" class="btn btn-primary">Se agentene</a>
        <a href="#eksempler" class="btn btn-secondary">Se eksempler</a>
      </div>

      <div class="flex flex-wrap items-center gap-x-10 gap-y-5">
        <div>
          <div class="text-3xl md:text-4xl font-extrabold text-ink leading-none tracking-tighter">6</div>
          <div class="text-sm text-ink-3 mt-1.5">AI-agenter</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-extrabold text-ink leading-none tracking-tighter">40+</div>
          <div class="text-sm text-ink-3 mt-1.5">År erfaring</div>
        </div>
        <div>
          <div class="text-3xl md:text-4xl font-extrabold text-ink leading-none tracking-tighter">4 000+</div>
          <div class="text-sm text-ink-3 mt-1.5">Prosjekter</div>
        </div>
      </div>
    </div>

    <!-- RIGHT: Animated AI architecture -->
    <div class="relative">
      <div class="aspect-[4/5] lg:aspect-square bg-cream rounded-3xl border border-line p-6 lg:p-8 flex items-center justify-center overflow-hidden relative">
        <svg viewBox="0 0 420 420" class="w-full h-full hero-svg">
          <defs>
            <radialGradient id="hubGlow" cx="50%" cy="50%" r="50%">
              <stop offset="0%" stop-color="#f5b400" stop-opacity="0.40"/>
              <stop offset="35%" stop-color="#f5b400" stop-opacity="0.10"/>
              <stop offset="100%" stop-color="#f5b400" stop-opacity="0"/>
            </radialGradient>

            <!-- Paths for animated particles (one per connection) -->
            <path id="p-loki"  d="M210 90  L210 210" fill="none"/>
            <path id="p-nova"  d="M330 145 L210 210" fill="none"/>
            <path id="p-tt"    d="M330 275 L210 210" fill="none"/>
            <path id="p-ki"    d="M210 330 L210 210" fill="none"/>
            <path id="p-epost" d="M90  275 L210 210" fill="none"/>
            <path id="p-hilde" d="M90  145 L210 210" fill="none"/>
          </defs>

          <!-- Concentric guide rings -->
          <circle cx="210" cy="210" r="170" fill="none" stroke="#1a1d23" stroke-opacity="0.06" stroke-dasharray="2 6" class="ring ring-slow"/>
          <circle cx="210" cy="210" r="130" fill="none" stroke="#1a1d23" stroke-opacity="0.04" stroke-dasharray="2 6" class="ring ring-rev"/>

          <!-- Base connection lines (subtle) -->
          <g stroke-width="1" fill="none">
            <line x1="210" y1="210" x2="210" y2="90"  stroke="#c8102e" stroke-opacity="0.20"/>
            <line x1="210" y1="210" x2="330" y2="145" stroke="#f5b400" stroke-opacity="0.20"/>
            <line x1="210" y1="210" x2="330" y2="275" stroke="#7a3fc8" stroke-opacity="0.20"/>
            <line x1="210" y1="210" x2="210" y2="330" stroke="#1f8a3a" stroke-opacity="0.20"/>
            <line x1="210" y1="210" x2="90"  y2="275" stroke="#ff6b35" stroke-opacity="0.20"/>
            <line x1="210" y1="210" x2="90"  y2="145" stroke="#0a6cf0" stroke-opacity="0.20"/>
          </g>

          <!-- Animated dashed flow lines (data flowing inward) -->
          <g stroke-width="1.5" fill="none" stroke-dasharray="4 10" stroke-linecap="round">
            <line x1="210" y1="90"  x2="210" y2="210" stroke="#c8102e" class="flow flow-1"/>
            <line x1="330" y1="145" x2="210" y2="210" stroke="#f5b400" class="flow flow-2"/>
            <line x1="330" y1="275" x2="210" y2="210" stroke="#7a3fc8" class="flow flow-3"/>
            <line x1="210" y1="330" x2="210" y2="210" stroke="#1f8a3a" class="flow flow-4"/>
            <line x1="90"  y1="275" x2="210" y2="210" stroke="#ff6b35" class="flow flow-5"/>
            <line x1="90"  y1="145" x2="210" y2="210" stroke="#0a6cf0" class="flow flow-6"/>
          </g>

          <!-- Traveling data particles (one per connection, staggered) -->
          <g>
            <circle r="3" fill="#c8102e" filter="drop-shadow(0 0 4px #c8102e)">
              <animateMotion dur="2.6s" repeatCount="indefinite" begin="0s"><mpath href="#p-loki"/></animateMotion>
            </circle>
            <circle r="3" fill="#f5b400" filter="drop-shadow(0 0 4px #f5b400)">
              <animateMotion dur="2.6s" repeatCount="indefinite" begin="-0.4s"><mpath href="#p-nova"/></animateMotion>
            </circle>
            <circle r="3" fill="#7a3fc8" filter="drop-shadow(0 0 4px #7a3fc8)">
              <animateMotion dur="2.6s" repeatCount="indefinite" begin="-0.8s"><mpath href="#p-tt"/></animateMotion>
            </circle>
            <circle r="3" fill="#1f8a3a" filter="drop-shadow(0 0 4px #1f8a3a)">
              <animateMotion dur="2.6s" repeatCount="indefinite" begin="-1.2s"><mpath href="#p-ki"/></animateMotion>
            </circle>
            <circle r="3" fill="#ff6b35" filter="drop-shadow(0 0 4px #ff6b35)">
              <animateMotion dur="2.6s" repeatCount="indefinite" begin="-1.6s"><mpath href="#p-epost"/></animateMotion>
            </circle>
            <circle r="3" fill="#0a6cf0" filter="drop-shadow(0 0 4px #0a6cf0)">
              <animateMotion dur="2.6s" repeatCount="indefinite" begin="-2.0s"><mpath href="#p-hilde"/></animateMotion>
            </circle>
          </g>

          <!-- Hub glow -->
          <circle cx="210" cy="210" r="100" fill="url(#hubGlow)" class="hub-glow"/>

          <!-- Hub circle -->
          <circle cx="210" cy="210" r="56" fill="#ffffff" stroke="#f5b400" stroke-width="2" class="hub-core"/>
          <text x="210" y="206" text-anchor="middle" font-family="Inter" font-size="18" font-weight="800" fill="#1a1d23">Claude</text>
          <text x="210" y="224" text-anchor="middle" font-family="Inter" font-size="10" font-weight="500" fill="#6b7280">Opus 4.7</text>

          <!-- Agent nodes (with pulse animation) -->
          <g class="node n-1">
            <circle cx="210" cy="90" r="26" fill="#ffffff" stroke="#c8102e" stroke-width="2"/>
            <text x="210" y="95" text-anchor="middle" font-family="Inter" font-size="10" font-weight="700" fill="#1a1d23">Loki</text>
          </g>
          <g class="node n-2">
            <circle cx="330" cy="145" r="26" fill="#ffffff" stroke="#f5b400" stroke-width="2"/>
            <text x="330" y="150" text-anchor="middle" font-family="Inter" font-size="10" font-weight="700" fill="#1a1d23">Nova</text>
          </g>
          <g class="node n-3">
            <circle cx="330" cy="275" r="26" fill="#ffffff" stroke="#7a3fc8" stroke-width="2"/>
            <text x="330" y="280" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#1a1d23">Tripletex</text>
          </g>
          <g class="node n-4">
            <circle cx="210" cy="330" r="26" fill="#ffffff" stroke="#1f8a3a" stroke-width="2"/>
            <text x="210" y="328" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#1a1d23">KI</text>
            <text x="210" y="340" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#1a1d23">Tilbud</text>
          </g>
          <g class="node n-5">
            <circle cx="90" cy="275" r="26" fill="#ffffff" stroke="#ff6b35" stroke-width="2"/>
            <text x="90" y="273" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#1a1d23">Epost-</text>
            <text x="90" y="285" text-anchor="middle" font-family="Inter" font-size="9" font-weight="700" fill="#1a1d23">agent</text>
          </g>
          <g class="node n-6">
            <circle cx="90" cy="145" r="26" fill="#ffffff" stroke="#0a6cf0" stroke-width="2"/>
            <text x="90" y="150" text-anchor="middle" font-family="Inter" font-size="10" font-weight="700" fill="#1a1d23">Hilde</text>
          </g>
        </svg>

        <!-- Corner label -->
        <div class="absolute top-5 left-5 z-10">
          <div class="text-xs font-mono text-ink-3 mb-0.5">// Live arkitektur</div>
          <div class="text-sm font-semibold text-ink">Kunnskap flyter til Claude</div>
        </div>
      </div>

      <!-- Bottom badges -->
      <div class="grid grid-cols-2 gap-3 mt-5">
        <div class="flex items-center gap-3 bg-white border border-line rounded-xl px-4 py-3">
          <span class="w-9 h-9 rounded-lg bg-green/10 flex items-center justify-center flex-shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#1f8a3a" stroke-width="2.5"><path d="M20 6L9 17l-5-5"/></svg>
          </span>
          <div>
            <div class="text-[13px] font-semibold text-ink leading-tight">Live i bruk</div>
            <div class="text-xs text-ink-3 mt-0.5">4 av 6 i produksjon</div>
          </div>
        </div>
        <div class="flex items-center gap-3 bg-white border border-line rounded-xl px-4 py-3">
          <span class="w-9 h-9 rounded-lg bg-yellow/15 flex items-center justify-center flex-shrink-0">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f5b400" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          </span>
          <div>
            <div class="text-[13px] font-semibold text-ink leading-tight">Sekunder</div>
            <div class="text-xs text-ink-3 mt-0.5">Fra prompt til PDF</div>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* === Animated AI architecture === */
  .hero-svg .ring {
    transform-origin: 210px 210px;
    animation: ring-spin 80s linear infinite;
  }
  .hero-svg .ring-rev { animation-duration: 120s; animation-direction: reverse; }

  @keyframes ring-spin { to { transform: rotate(360deg); } }

  /* Dashed flow lines */
  .hero-svg .flow {
    animation: flow-dash 1.6s linear infinite;
  }
  .hero-svg .flow-2 { animation-delay: -0.27s; }
  .hero-svg .flow-3 { animation-delay: -0.54s; }
  .hero-svg .flow-4 { animation-delay: -0.80s; }
  .hero-svg .flow-5 { animation-delay: -1.07s; }
  .hero-svg .flow-6 { animation-delay: -1.34s; }
  @keyframes flow-dash {
    to { stroke-dashoffset: -28; }
  }

  /* Node breathing */
  .hero-svg .node {
    transform-origin: center;
    transform-box: fill-box;
    animation: node-breathe 3.6s ease-in-out infinite;
  }
  .hero-svg .n-2 { animation-delay: -0.6s; }
  .hero-svg .n-3 { animation-delay: -1.2s; }
  .hero-svg .n-4 { animation-delay: -1.8s; }
  .hero-svg .n-5 { animation-delay: -2.4s; }
  .hero-svg .n-6 { animation-delay: -3.0s; }
  @keyframes node-breathe {
    0%, 100% { filter: drop-shadow(0 0 0 transparent); }
    50%      { filter: drop-shadow(0 0 6px currentColor); }
  }

  /* Hub glow pulse */
  .hero-svg .hub-glow {
    transform-origin: 210px 210px;
    animation: hub-pulse 4s ease-in-out infinite;
  }
  .hero-svg .hub-core {
    filter: drop-shadow(0 4px 12px rgba(245, 180, 0, 0.30));
  }
  @keyframes hub-pulse {
    0%, 100% { opacity: 0.7; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.08); }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .hero-svg .ring,
    .hero-svg .flow,
    .hero-svg .node,
    .hero-svg .hub-glow,
    .hero-svg animateMotion {
      animation: none !important;
    }
  }
</style>

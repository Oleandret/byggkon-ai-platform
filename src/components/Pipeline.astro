---
// Pipeline section — clean horizontal flow with 4 stages
const flows = [
  {
    id: 'dispensasjon',
    title: 'Søknad om dispensasjon',
    input: 'Lag søknad om dispensasjon fra TEK17 §13-7 for prosjekt Solås.',
    agents: ['Loki', 'Nova', 'Hilde', 'Tripletex', 'Epostagent'],
    output: 'Dispensasjonssøknad.pdf',
    meta: '4 sider · BYGG-KON-mal',
    time: '38 sek'
  },
  {
    id: 'uak',
    title: 'Sjekkliste · UAK',
    input: 'Lag UAK-sjekkliste for våtrom i prosjekt Steinerskolen.',
    agents: ['Loki', 'Nova', 'Tripletex'],
    output: 'UAK-sjekkliste-Vatrom.pdf',
    meta: '32 kontrollpunkter · 6 sider',
    time: '22 sek'
  },
  {
    id: 'ks',
    title: 'KS-plan betong',
    input: 'Lag KS-plan for betongprosjektering — enebolig på Solåsen.',
    agents: ['Loki', 'Nova', 'Hilde', 'Tripletex'],
    output: 'KS-plan-Betong-4118.pdf',
    meta: '12 sider · NS 3473 · 24 kontrollpunkter',
    time: '51 sek'
  },
  {
    id: 'befaring',
    title: 'Befaringsrapport · stål',
    input: 'Skriv befaringsrapport — stålknutepunkt på prosjekt Interwell 4072.',
    agents: ['Loki', 'Nova', 'Tripletex', 'Epostagent'],
    output: 'Befaringsrapport-stal-4072.pdf',
    meta: '8 sider · 14 funn · 3 avvik',
    time: '33 sek'
  }
];
---
<section id="pipeline" class="py-24 bg-soft border-y border-[var(--line)]">
  <div class="wrap">
    <div class="text-center mb-12 max-w-[720px] mx-auto">
      <span class="eyebrow">// Pipeline</span>
      <h2 class="h2 mt-3">Fra prompt til ferdig dokument.</h2>
      <p class="lede mt-3 mx-auto">Fire eksempler — velg ett for å se hvilke agenter som leverer hva.</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-8 max-w-[920px] mx-auto" role="tablist">
      {flows.map((f, i) => (
        <button
          class:list={['pipe-tab px-4 py-3 rounded-xl text-left text-sm font-medium transition-all', i === 0 ? 'bg-ink text-white border-ink' : 'bg-white text-ink border border-[var(--line)] hover:border-ink']}
          data-tab={f.id}
        >
          {f.title}
        </button>
      ))}
    </div>

    <div class="bg-white border border-[var(--line)] rounded-2xl p-7 md:p-9 shadow-sm max-w-[1100px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-[1fr_auto_1fr_auto_1fr] gap-6 items-center">
        <!-- Input -->
        <div>
          <div class="font-mono text-[10.5px] font-bold uppercase tracking-[0.16em] text-ink-3 mb-3">01 · Forespørsel</div>
          <div class="bg-soft rounded-xl p-4 border border-[var(--line)]">
            <p class="text-sm italic text-ink leading-relaxed" data-flow-input>
              {flows[0].input}
            </p>
          </div>
        </div>

        <div class="hidden md:block text-ink-4">
          <svg width="32" height="20" viewBox="0 0 32 20" fill="none">
            <path d="M0 10 L26 10 M22 5 L28 10 L22 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <!-- Agents -->
        <div>
          <div class="font-mono text-[10.5px] font-bold uppercase tracking-[0.16em] text-ink-3 mb-3">02 · Innhenting</div>
          <div class="flex flex-wrap gap-1.5" data-flow-agents>
            {flows[0].agents.map(a => (
              <span class="px-2.5 py-1 bg-ki/[0.10] text-ki rounded-md font-mono text-[11px] font-semibold">{a}</span>
            ))}
          </div>
          <div class="mt-3 text-[11px] font-mono text-ink-4">→ Claude Opus 4.7 syntetiserer</div>
        </div>

        <div class="hidden md:block text-ink-4">
          <svg width="32" height="20" viewBox="0 0 32 20" fill="none">
            <path d="M0 10 L26 10 M22 5 L28 10 L22 15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>

        <!-- Output -->
        <div>
          <div class="font-mono text-[10.5px] font-bold uppercase tracking-[0.16em] text-ink-3 mb-3">03 · Leveranse</div>
          <div class="bg-soft rounded-xl p-4 border border-[var(--line)]">
            <div class="flex items-center gap-3">
              <span class="text-2xl">📄</span>
              <div>
                <div class="text-sm font-bold text-ink leading-tight" data-flow-output>{flows[0].output}</div>
                <div class="font-mono text-[10.5px] text-ink-3 mt-1" data-flow-meta>{flows[0].meta}</div>
              </div>
            </div>
            <div class="mt-3 inline-flex items-center gap-1.5 text-xs font-mono">
              <span class="text-ink-3">⚡ Tid:</span>
              <span class="font-bold text-loki" data-flow-time>{flows[0].time}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ flows }}>
  const tabs = document.querySelectorAll('.pipe-tab');
  const input = document.querySelector('[data-flow-input]');
  const agentsEl = document.querySelector('[data-flow-agents]');
  const output = document.querySelector('[data-flow-output]');
  const meta = document.querySelector('[data-flow-meta]');
  const time = document.querySelector('[data-flow-time]');

  function applyFlow(id) {
    const f = flows.find(x => x.id === id);
    if (!f || !input || !agentsEl || !output || !meta || !time) return;
    // Smooth fade
    [input, agentsEl, output, meta, time].forEach(el => {
      el.style.transition = 'opacity .2s ease';
      el.style.opacity = '0';
    });
    setTimeout(() => {
      input.textContent = f.input;
      output.textContent = f.output;
      meta.textContent = f.meta;
      time.textContent = f.time;
      agentsEl.innerHTML = f.agents.map(a =>
        `<span class="px-2.5 py-1 bg-ki/[0.10] text-ki rounded-md font-mono text-[11px] font-semibold">${a}</span>`
      ).join('');
      [input, agentsEl, output, meta, time].forEach(el => { el.style.opacity = '1'; });
    }, 200);
  }

  tabs.forEach(t => {
    t.addEventListener('click', () => {
      tabs.forEach(b => {
        b.classList.remove('bg-ink', 'text-white', 'border-ink');
        b.classList.add('bg-white', 'text-ink', 'border', 'border-[var(--line)]');
      });
      t.classList.remove('bg-white', 'text-ink', 'border-[var(--line)]');
      t.classList.add('bg-ink', 'text-white', 'border-ink');
      applyFlow(t.getAttribute('data-tab'));
    });
  });
</script>

---
// Prosess — subtle animated flow diagram showing knowledge moving through the system
---
<section id="prosess" class="py-20 lg:py-28">
  <div class="wrap">

    <div class="max-w-[700px] mb-12 lg:mb-16">
      <div class="eyebrow mb-4">Prosessen</div>
      <h2 class="h2 mb-5">Slik flyter kunnskapen</h2>
      <p class="text-lg text-ink-2 leading-[1.65]">
        En forespørsel fra en ansatt utløser flere agenter samtidig. Hver henter
        sin del av konteksten &mdash; Claude binder det sammen til ett ferdig dokument.
      </p>
    </div>

    <!-- Process diagram card -->
    <div class="bg-cream rounded-3xl border border-line p-6 lg:p-10">
      <svg viewBox="0 0 1100 460" class="w-full h-auto prosess-svg" preserveAspectRatio="xMidYMid meet" role="img" aria-label="Prosess-diagram">

        <!-- Definitions: paths the particles will follow -->
        <defs>
          <!-- Source → Claude paths -->
          <path id="path-1" d="M 200 100 C 300 100 350 230 550 230" fill="none"/>
          <path id="path-2" d="M 200 180 C 300 180 350 230 550 230" fill="none"/>
          <path id="path-3" d="M 200 260 C 300 260 350 230 550 230" fill="none"/>
          <path id="path-4" d="M 200 340 C 300 340 350 230 550 230" fill="none"/>
          <!-- Claude → Output -->
          <path id="path-out" d="M 650 230 C 760 230 800 230 900 230" fill="none"/>
        </defs>

        <!-- LABELS: Three zones -->
        <text x="200" y="40" text-anchor="middle" font-family="Inter" font-size="11" font-weight="600" fill="#6b7280" letter-spacing="1.5">01 · KILDER</text>
        <text x="600" y="40" text-anchor="middle" font-family="Inter" font-size="11" font-weight="600" fill="#6b7280" letter-spacing="1.5">02 · RESONNEMENT</text>
        <text x="900" y="40" text-anchor="middle" font-family="Inter" font-size="11" font-weight="600" fill="#6b7280" letter-spacing="1.5">03 · LEVERANSE</text>

        <!-- Connection lines (subtle) -->
        <g stroke="#1a1d23" stroke-opacity="0.10" stroke-width="1" fill="none">
          <path d="M 200 100 C 300 100 350 230 550 230"/>
          <path d="M 200 180 C 300 180 350 230 550 230"/>
          <path d="M 200 260 C 300 260 350 230 550 230"/>
          <path d="M 200 340 C 300 340 350 230 550 230"/>
          <path d="M 650 230 C 760 230 800 230 900 230"/>
        </g>

        <!-- Source nodes (left column) -->
        <g class="source-node">
          <rect x="120" y="80" width="160" height="40" rx="20" fill="#ffffff" stroke="#c8102e" stroke-width="1.5"/>
          <circle cx="146" cy="100" r="4" fill="#c8102e"/>
          <text x="160" y="105" font-family="Inter" font-size="13" font-weight="700" fill="#1a1d23">Loki</text>
          <text x="200" y="105" font-family="Inter" font-size="11" fill="#6b7280">Intern kunnskap</text>
        </g>

        <g class="source-node">
          <rect x="120" y="160" width="160" height="40" rx="20" fill="#ffffff" stroke="#f5b400" stroke-width="1.5"/>
          <circle cx="146" cy="180" r="4" fill="#f5b400"/>
          <text x="160" y="185" font-family="Inter" font-size="13" font-weight="700" fill="#1a1d23">Nova</text>
          <text x="200" y="185" font-family="Inter" font-size="11" fill="#6b7280">Regelverk</text>
        </g>

        <g class="source-node">
          <rect x="120" y="240" width="160" height="40" rx="20" fill="#ffffff" stroke="#0a6cf0" stroke-width="1.5"/>
          <circle cx="146" cy="260" r="4" fill="#0a6cf0"/>
          <text x="160" y="265" font-family="Inter" font-size="13" font-weight="700" fill="#1a1d23">Hilde</text>
          <text x="200" y="265" font-family="Inter" font-size="11" fill="#6b7280">Eiendomsdata</text>
        </g>

        <g class="source-node">
          <rect x="120" y="320" width="160" height="40" rx="20" fill="#ffffff" stroke="#7a3fc8" stroke-width="1.5"/>
          <circle cx="146" cy="340" r="4" fill="#7a3fc8"/>
          <text x="160" y="345" font-family="Inter" font-size="13" font-weight="700" fill="#1a1d23">Tripletex</text>
          <text x="200" y="345" font-family="Inter" font-size="11" fill="#6b7280">Økonomi</text>
        </g>

        <!-- Claude hub (centre) -->
        <g class="hub">
          <circle cx="600" cy="230" r="68" fill="#ffffff" stroke="#1a1d23" stroke-width="1.5"/>
          <circle cx="600" cy="230" r="78" fill="none" stroke="#f5b400" stroke-opacity="0.30" stroke-width="1" stroke-dasharray="3 5"/>
          <text x="600" y="226" text-anchor="middle" font-family="Inter" font-size="16" font-weight="800" fill="#1a1d23">Claude</text>
          <text x="600" y="245" text-anchor="middle" font-family="Inter" font-size="10" font-weight="500" fill="#6b7280">Opus 4.7</text>
        </g>

        <!-- Output node (right) -->
        <g class="output-node">
          <rect x="850" y="195" width="160" height="70" rx="10" fill="#ffffff" stroke="#1a1d23" stroke-width="1.5"/>
          <text x="930" y="225" text-anchor="middle" font-family="Inter" font-size="13" font-weight="700" fill="#1a1d23">📄 Dokument</text>
          <text x="930" y="248" text-anchor="middle" font-family="Inter" font-size="11" fill="#6b7280">Klar til signering</text>
        </g>

        <!-- ANIMATED PARTICLES — knowledge flowing in -->
        <g>
          <circle r="4" fill="#c8102e">
            <animateMotion dur="3.2s" repeatCount="indefinite" begin="0s">
              <mpath href="#path-1"/>
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0" dur="3.2s" repeatCount="indefinite" begin="0s"/>
          </circle>
          <circle r="4" fill="#f5b400">
            <animateMotion dur="3.2s" repeatCount="indefinite" begin="-0.8s">
              <mpath href="#path-2"/>
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0" dur="3.2s" repeatCount="indefinite" begin="-0.8s"/>
          </circle>
          <circle r="4" fill="#0a6cf0">
            <animateMotion dur="3.2s" repeatCount="indefinite" begin="-1.6s">
              <mpath href="#path-3"/>
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0" dur="3.2s" repeatCount="indefinite" begin="-1.6s"/>
          </circle>
          <circle r="4" fill="#7a3fc8">
            <animateMotion dur="3.2s" repeatCount="indefinite" begin="-2.4s">
              <mpath href="#path-4"/>
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0" dur="3.2s" repeatCount="indefinite" begin="-2.4s"/>
          </circle>
        </g>

        <!-- Output flow particle -->
        <g>
          <circle r="4" fill="#1a1d23">
            <animateMotion dur="2.4s" repeatCount="indefinite" begin="-1s">
              <mpath href="#path-out"/>
            </animateMotion>
            <animate attributeName="opacity" values="0;1;1;0" dur="2.4s" repeatCount="indefinite" begin="-1s"/>
          </circle>
        </g>

      </svg>

      <!-- Steg-tekst under diagrammet -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-10 pt-8 border-t border-line">
        <div>
          <div class="text-sm font-bold text-ink mb-1">1. Kilder</div>
          <p class="text-sm text-ink-3 leading-relaxed">
            Loki, Nova, Hilde og Tripletex henter relevant kontekst i parallell.
          </p>
        </div>
        <div>
          <div class="text-sm font-bold text-ink mb-1">2. Resonnement</div>
          <p class="text-sm text-ink-3 leading-relaxed">
            Claude binder kunnskapen sammen og strukturerer det i riktig format.
          </p>
        </div>
        <div>
          <div class="text-sm font-bold text-ink mb-1">3. Leveranse</div>
          <p class="text-sm text-ink-3 leading-relaxed">
            Ferdig dokument klart for gjennomgang og signering.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .prosess-svg animateMotion,
    .prosess-svg animate {
      animation-play-state: paused;
    }
  }
</style>

---
import { agents } from '../data/agents';

const icons: Record<string, string> = {
  loki:        `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  nova:        `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10z"/></svg>`,
  hilde:       `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  tripletex:   `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  epost:       `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
  'ki-tilbud': `<svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 13h6M9 17h4"/></svg>`
};
---
<section id="agenter" class="py-20 lg:py-28 bg-cream">
  <div class="wrap">

    <!-- byggkon.no header pattern: eyebrow + h2 + paragraph -->
    <div class="max-w-[700px] mb-12 lg:mb-16">
      <div class="eyebrow mb-4">Våre AI-agenter</div>
      <h2 class="h2 mb-5">Spesialiserte agenter for byggfaget</h2>
      <p class="text-lg text-ink-2 leading-[1.65]">
        Seks AI-agenter som dekker hele dokumentasjonsprosessen &mdash; fra kunnskapsinnhenting
        til ferdig levert dokument. Hver agent har sitt eget oppdrag, koblet sammen via Claude.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
      {agents.map(agent => (
        <a
          href={`/agent/${agent.slug}`}
          class="group flex flex-col bg-white rounded-2xl p-8 lg:p-9 transition-all hover:-translate-y-1 hover:shadow-[0_24px_60px_-20px_rgba(20,24,32,0.10)]"
        >
          <!-- Icon badge — byggkon.no style: colored square -->
          <div
            class="w-14 h-14 rounded-xl flex items-center justify-center mb-8"
            style={`background:${agent.color}1a; color:${agent.color};`}
          >
            <Fragment set:html={icons[agent.slug] ?? ''} />
          </div>

          <h3 class="text-2xl font-extrabold text-ink leading-tight mb-4">
            {agent.name}
          </h3>

          <p class="text-[15px] text-ink-2 leading-[1.65] mb-7 flex-1">
            {agent.description}
          </p>

          <span class="text-sm font-semibold inline-flex items-center gap-1.5 transition-transform group-hover:translate-x-0.5" style={`color:${agent.color}`}>
            Les mer
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14M13 5l7 7-7 7"/>
            </svg>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-12 text-center">
      <a href="/#eksempler" class="link-arrow">Se eksempler på leveranser</a>
    </div>
  </div>
</section>

---
import { agents } from '../data/agents';

const icons: Record<string, string> = {
  loki:        `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5"/><path d="M2 12l10 5 10-5"/></svg>`,
  nova:        `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10z"/></svg>`,
  hilde:       `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>`,
  tripletex:   `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  epost:       `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
  'ki-tilbud': `<svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6M9 13h6M9 17h4"/></svg>`
};
---
<section id="agenter" class="py-20 lg:py-28 bg-cream">
  <div class="wrap">
    <div class="max-w-[640px] mb-12 lg:mb-16">
      <div class="eyebrow mb-3">Agentene</div>
      <h2 class="h2 mb-5">Seks AI-agenter for byggfaget.</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {agents.map(agent => (
        <a
          href={`/agent/${agent.slug}`}
          class="group block bg-white rounded-2xl p-7 lg:p-8 transition-all hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-20px_rgba(20,24,32,0.10)]"
        >
          <div
            class="w-12 h-12 rounded-xl flex items-center justify-center mb-7"
            style={`background:${agent.color}1a; color:${agent.color};`}
          >
            <Fragment set:html={icons[agent.slug] ?? ''} />
          </div>

          <h3 class="h3 mb-2">{agent.name}</h3>
          <p class="text-[15px] text-ink-3 leading-relaxed mb-6">
            {agent.tagline}
          </p>

          <span class="text-sm font-semibold link-arrow" style={`color:${agent.color}`}>
            Se mer
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

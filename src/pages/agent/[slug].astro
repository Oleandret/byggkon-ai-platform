---
import Layout from '../../layouts/Layout.astro';
import { agents, getAgent } from '../../data/agents';

const { slug } = Astro.params;
const agent = slug ? getAgent(slug) : undefined;

if (!agent) {
  return Astro.redirect('/');
}

const statusLabel = agent.status === 'beta' ? 'Beta — under testing' : 'Live i produksjon';
const statusColor = agent.status === 'beta' ? '#b88600' : '#1f8a3a';

// Related agents (next 2)
const others = agents.filter(a => a.slug !== agent.slug).slice(0, 2);
---
<Layout title={`${agent.name} — BYGG-KON.ai`} description={agent.tagline}>

  <!-- Hero / header -->
  <section class="pt-36 pb-16 relative overflow-hidden">
    <div class="absolute inset-0 -z-10"
         style={`background: radial-gradient(ellipse 60% 40% at 50% 0%, ${agent.color}10, transparent 60%);`}>
    </div>
    <div class="wrap max-w-[920px]">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-ink-3 hover:text-ink mb-6 transition-colors">
        ← Tilbake
      </a>

      <div class="flex items-center gap-3 mb-5">
        <span class="font-mono text-xs font-bold tracking-[0.18em]" style={`color:${agent.color}`}>
          {agent.num} · {agent.role}
        </span>
        <span class="inline-flex items-center gap-1.5 font-mono text-[11px] font-semibold tracking-wide uppercase px-2.5 py-1 rounded-full"
              style={`background:${statusColor}1a; color:${statusColor};`}>
          <span class="w-1.5 h-1.5 rounded-full inline-block" style={`background:${statusColor}`}></span>
          {statusLabel}
        </span>
      </div>

      <h1 class="font-extrabold text-ink leading-[1.05] tracking-[-0.03em]" style="font-size: clamp(40px, 7vw, 80px);">
        {agent.name}
      </h1>
      <p class="text-lg md:text-xl text-ink-3 mt-4 max-w-[680px] leading-relaxed">
        {agent.tagline}
      </p>

      <p class="text-base text-ink-2 mt-6 max-w-[680px] leading-relaxed">
        {agent.description}
      </p>

      {agent.url && (
        <a href={agent.url} target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 mt-7 px-5 py-2.5 rounded-full bg-ink text-white text-sm font-semibold hover:-translate-y-0.5 transition-transform">
          Åpne {agent.name} ↗
        </a>
      )}
    </div>
  </section>

  <!-- Pipeline -->
  <section class="py-16 bg-soft border-y border-[var(--line)]">
    <div class="wrap max-w-[1100px]">
      <span class="eyebrow">// Pipeline</span>
      <h2 class="h2 mt-3 mb-10">Slik flyter dataen.</h2>

      <div class="grid grid-cols-1 md:grid-cols-9 gap-3 items-stretch">
        {agent.pipeline.map((step, i) => (
          <>
            <div class="bg-white rounded-xl border border-[var(--line)] p-5 text-center md:col-span-1"
                 style={`grid-column: span 1 / span 1;`}>
              <div class="text-3xl mb-2">{step.i}</div>
              <div class="font-mono text-[11px] font-bold tracking-wider uppercase mb-1" style={`color:${agent.color}`}>{step.n}</div>
              <div class="text-[11.5px] text-ink-3 leading-snug">{step.d}</div>
            </div>
            {i < agent.pipeline.length - 1 && (
              <div class="hidden md:flex items-center justify-center text-ink-4">
                <svg width="20" height="14" viewBox="0 0 20 14" fill="none">
                  <path d="M0 7 L16 7 M12 3 L18 7 L12 11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </div>
            )}
          </>
        ))}
      </div>
    </div>
  </section>

  <!-- Details -->
  <section class="py-16">
    <div class="wrap max-w-[920px]">
      <span class="eyebrow">// Tekniske detaljer</span>
      <h2 class="h2 mt-3 mb-8">Under panseret.</h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {agent.details.map(d => (
          <div class="bg-white border border-[var(--line)] rounded-xl p-5">
            <div class="font-mono text-[10.5px] uppercase tracking-[0.16em] text-ink-3 mb-1.5">
              {d.k}
            </div>
            <div class="text-[15px] font-semibold text-ink">{d.v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Related -->
  <section class="py-16 bg-soft border-t border-[var(--line)]">
    <div class="wrap max-w-[920px]">
      <span class="eyebrow">// Andre agenter</span>
      <h2 class="h2 mt-3 mb-8">Utforsk videre.</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
        {others.map(o => (
          <a href={`/agent/${o.slug}`}
             class="group flex items-center justify-between bg-white border border-[var(--line)] rounded-2xl p-5 hover:-translate-y-0.5 transition-all hover:shadow-sm"
             style={`--c:${o.color}`}>
            <div>
              <div class="font-mono text-[11px] font-bold tracking-[0.16em]" style={`color:${o.color}`}>{o.num}</div>
              <div class="text-lg font-extrabold mt-1">{o.name}</div>
              <div class="text-sm text-ink-3 mt-0.5">{o.role}</div>
            </div>
            <span class="text-2xl opacity-50 group-hover:opacity-100 group-hover:translate-x-1 transition-all" style={`color:${o.color}`}>→</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { agents, getAgent } from '../../data/agents';

const { slug } = Astro.params;
const agent = slug ? getAgent(slug) : undefined;

if (!agent) {
  return Astro.redirect('/');
}

const isBeta = agent.status === 'beta';
const statusLabel = isBeta ? 'Beta — under testing' : 'Live i produksjon';
const statusBg = isBeta ? 'bg-yellow/15' : 'bg-green/10';
const statusFg = isBeta ? 'text-[#8a6300]' : 'text-green';

const others = agents.filter(a => a.slug !== agent.slug).slice(0, 3);
---
<Layout title={`${agent.name} — BYGG-KON.ai`} description={agent.tagline}>

  <!-- Hero -->
  <section class="pt-32 pb-16 lg:pt-40 lg:pb-20">
    <div class="wrap max-w-[920px]">
      <a href="/" class="inline-flex items-center gap-1.5 text-sm text-ink-3 hover:text-ink mb-8 transition-colors">
        ← Tilbake til oversikt
      </a>

      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="text-sm font-semibold tracking-wider uppercase" style={`color:${agent.color}`}>
          {agent.num} · {agent.role}
        </span>
        <span class={`inline-flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full ${statusBg} ${statusFg}`}>
          <span class="w-1.5 h-1.5 rounded-full bg-current"></span>
          {statusLabel}
        </span>
      </div>

      <h1 class="h1 mb-6">{agent.name}</h1>
      <p class="lede mb-6 max-w-[680px]">
        {agent.tagline}
      </p>
      <p class="text-base text-ink-2 max-w-[680px] leading-relaxed">
        {agent.description}
      </p>

      {agent.url && (
        <div class="mt-8">
          <a href={agent.url} target="_blank" rel="noopener" class="btn btn-primary">
            Åpne {agent.name} ↗
          </a>
        </div>
      )}
    </div>
  </section>

  <!-- Pipeline -->
  <section class="py-16 lg:py-20 bg-cream">
    <div class="wrap max-w-[1100px]">
      <div class="mb-10">
        <div class="eyebrow mb-3">Pipeline</div>
        <h2 class="h2">Slik flyter dataen.</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-3">
        {agent.pipeline.map((step, i) => (
          <div class="bg-white rounded-2xl border border-line p-6 text-center relative">
            <div class="text-[10px] font-mono font-bold tracking-wider uppercase mb-3" style={`color:${agent.color}`}>
              0{i + 1}
            </div>
            <div class="text-3xl mb-3">{step.i}</div>
            <div class="text-sm font-bold text-ink mb-1">{step.n}</div>
            <div class="text-xs text-ink-3 leading-relaxed">{step.d}</div>
            {i < agent.pipeline.length - 1 && (
              <div class="hidden md:block absolute top-1/2 -right-2 -translate-y-1/2 text-ink-4 z-10">
                <svg width="16" height="10" viewBox="0 0 16 10" fill="none">
                  <path d="M0 5 L12 5 M8 1 L14 5 L8 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Details -->
  <section class="py-16 lg:py-20">
    <div class="wrap max-w-[920px]">
      <div class="mb-10">
        <div class="eyebrow mb-3">Detaljer</div>
        <h2 class="h2">Under panseret.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {agent.details.map(d => (
          <div class="bg-white border border-line rounded-2xl p-6">
            <div class="text-xs text-ink-3 uppercase tracking-wider font-semibold mb-2">
              {d.k}
            </div>
            <div class="text-base font-semibold text-ink">{d.v}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Other agents -->
  <section class="py-16 lg:py-20 bg-cream">
    <div class="wrap">
      <div class="mb-10">
        <div class="eyebrow mb-3">Andre agenter</div>
        <h2 class="h2">Utforsk videre.</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {others.map(o => (
          <a href={`/agent/${o.slug}`} class="group block bg-white rounded-2xl p-6 transition-all hover:-translate-y-1 hover:shadow-[0_24px_60px_-20px_rgba(20,24,32,0.12)]">
            <div class="w-10 h-10 rounded-lg mb-5 flex items-center justify-center" style={`background:${o.color}1a; color:${o.color};`}>
              <span class="text-xs font-bold">{o.num}</span>
            </div>
            <h3 class="text-lg font-extrabold mb-1">{o.name}</h3>
            <p class="text-sm text-ink-3 mb-4">{o.role}</p>
            <span class="text-sm font-semibold inline-flex items-center gap-1.5 transition-transform group-hover:translate-x-1" style={`color:${o.color}`}>
              Se mer →
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

</Layout>
